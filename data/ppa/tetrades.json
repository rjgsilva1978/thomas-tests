  "interpretacao": {
    "D": {
      "alto": "Orientado para resultados e desafios. Decide depressa, assume o controlo, aceita riscos e gosta de competir. Sob pressão pode tornar-se impaciente ou demasiado direto.",
      "baixo": "Prefere cooperar a competir e evita confrontos. Pondera antes de decidir e sente-se mais confortável quando a autoridade e os objetivos estão bem definidos."
    },
    "I": {
      "alto": "Orientado para as pessoas. Comunicativo, otimista e persuasivo, cria relações com facilidade e motiva os outros. Pode dispersar-se ou descurar o detalhe.",
      "baixo": "Reservado e factual nas relações profissionais. Prefere dados e lógica a apelos emocionais e trabalha bem de forma independente, sem precisar de reconhecimento social."
    },
    "S": {
      "alto": "Paciente, leal e consistente. Valoriza a estabilidade, um ritmo previsível e o trabalho em equipa. Ouve bem os outros, mas pode resistir a mudanças rápidas.",
      "baixo": "Gosta de variedade e de mudança, reage depressa e lida bem com várias tarefas em simultâneo. Pode mostrar impaciência com rotinas e processos lentos."
    },
    "C": {
      "alto": "Preciso, sistemático e orientado para a qualidade. Segue regras e procedimentos, analisa os factos antes de agir e evita erros. Pode ser excessivamente crítico ou cauteloso.",
      "baixo": "Independente e flexível face a regras e procedimentos. Prefere uma visão global ao detalhe e sente-se confortável a improvisar quando a situação o exige."
    }
